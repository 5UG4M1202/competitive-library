	"@Mos": {
		"prefix": "@mos",
		"body": [
			"  vector<pair<int, int>> lr(Q);",
			"  for (ll i = 0; i < Q; i++) {",
			"    cin >> lr[i].first >> lr[i].second;",
			"    lr[i].first--;  // 0-based indexに変換",
			"    lr[i].second--;",
			"  }",
			"  // Mo's algorithmでクエリをソート",
			"  ll W = 2e7; // Lの値域",
			"  ll block_size = max(1LL, (long long)(W / sqrt((long double)Q)));",
			"  vector<int> order(Q);",
			"  iota(order.begin(), order.end(), 0);",
			"  sort(order.begin(), order.end(), [&](int a, int b) {",
			"    if (lr[a].first / block_size != lr[b].first / block_size)",
			"      return lr[a].first < lr[b].first;",
			"    return (lr[a].first / block_size) % 2 ? lr[a].second > lr[b].second",
			"                                          : lr[a].second < lr[b].second;",
			"  });",
			"",
			"  // クエリを処理",
			"  vector<ll> ans(Q);  // 答えを格納",
			"  // 求めたい結果を管理できるものを宣言",
			"  ll ret = 0;",
			"  int l = 0, r = 0;",
			"  for (ll i = 0; i < Q; i++) {",
			"    int idx = order[i];",
			"    while (l > lr[idx].first) {  // lを下げて範囲を広げる処理",
			"      l--;",
			"      // lを下げるときの追加処理をここに書く",
			"      ",
			"    }",
			"    while (r < lr[idx].second) {  // rを上げて範囲を広げる処理",
			"      r++;",
			"      // rを上げるときの追加処理をここに書く",
			"",
			"    }",
			"    while (l < lr[idx].first) {  // lを上げて範囲を狭める処理",
			"      // lを上げるときの追加処理をここに書く",
			"",
			"      l++;",
			"    }",
			"",
			"    while (r > lr[idx].second) {  // rを下げて範囲を狭める処理",
			"      // rを下げるときの追加処理をここに書く",
			"",
			"      r--;",
			"    }",
			"    ans[idx] = ret;  // 結果の格納",
			"  }",
		],
		"description": ""
	},
	"UnionFind": {
		"prefix": "UFstruct",
		"body": [
			"struct UnionFind {",
			" public:",
			"  UnionFind() : _n(0) {}",
			"  explicit UnionFind(int n) : _n(n), parent_or_size(n, -1) {}  //親",
			"",
			"  int root(int x) {  //親を返す",
			"    assert(0 <= x && x < _n);",
			"    if (parent_or_size[x] < 0) return x;",
			"    return parent_or_size[x] = root(parent_or_size[x]);  //親をrootにつなぎ直す",
			"  }",
			"",
			"  int unite(int x, int y) {",
			"    assert(0 <= x && x < _n);",
			"    assert(0 <= y && y < _n);",
			"    int rx = root(x), ry = root(y);",
			"    if (rx == ry) return rx;",
			"    if (-parent_or_size[rx] < -parent_or_size[ry]) swap(rx, ry);",
			"    parent_or_size[rx] += parent_or_size[ry];  // Union by Size",
			"    parent_or_size[ry] = rx;  //root(y)の親をroot(x)にする",
			"    return rx;",
			"  }",
			"",
			"  bool same(int x, int y) {",
			"    assert(0 <= x && x < _n);",
			"    assert(0 <= y && y < _n);",
			"    return root(x) == root(y);",
			"  }",
			"  // 連結成分の要素数",
			"  int size(int x) {",
			"    assert(0 <= x && x < _n);",
			"    return -parent_or_size[root(x)];",
			"  }",
			"",
			"  vector<vector<int>> groups() {",
			"    vector<int> leader_buf(_n), group_size(_n);",
			"    for (int i = 0; i < _n; i++) {",
			"      leader_buf[i] = root(i);",
			"      group_size[leader_buf[i]]++;",
			"    }",
			"    vector<vector<int>> result(_n);",
			"    for (int i = 0; i < _n; i++) {",
			"      result[i].reserve(group_size[i]);",
			"    }",
			"    for (int i = 0; i < _n; i++) {",
			"      result[leader_buf[i]].emplace_back(i);",
			"    }",
			"    result.erase(remove_if(result.begin(), result.end(),",
			"                           [&](const vector<int>& v) { return v.empty(); }),",
			"                 result.end());",
			"    return result;",
			"  }",
			"",
			" private:",
			"  int _n;                      // 頂点の数",
			"  vector<int> parent_or_size;  // <0 : 根 -1 * size,  >=0 親",
			"};"
		],
		"description": "UnionFind"
	},
